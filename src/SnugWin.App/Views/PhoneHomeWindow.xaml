<Window x:Class="SnugWin.App.Views.PhoneHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snug 手机屏 - App 资源库"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource PhoneBg}"
        Foreground="{DynamicResource PhoneTextPrimary}">
    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AppCard DataTemplate -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Margin="0,0,0,12">
                <StackPanel>
                    <!-- App Header -->
                    <Grid Margin="16,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource FlatBtn}"
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="{Binding NotQuitting}"
                                Click="OnAppHeaderClick" Tag="{Binding App}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="15" Foreground="{Binding SubtitleBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Actions: Normal / AskingQuit / Quitting -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding NormalActionsVis}">
                                <Button Style="{StaticResource FlatBtn}" Padding="0" Width="48" Height="48" Margin="0,0,8,0"
                                        Click="OnNewWindow" Tag="{Binding App}" ToolTip="新建窗口">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PhoneBg}">
                                        <TextBlock Text="+" FontSize="24" Foreground="{DynamicResource PhoneTintBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource FlatBtn}" Padding="0" Width="48" Height="48"
                                        Click="OnAskQuitApp" Tag="{Binding}" ToolTip="退出 App">
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PhoneBg}">
                                        <TextBlock Text="×" FontSize="22" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Visibility="{Binding AskQuitVis}">
                                <Button Style="{StaticResource FlatBtn}" Padding="0" Margin="0,0,8,0" Click="OnCancelConfirm">
                                    <Border Height="40" CornerRadius="20" Background="{DynamicResource PhoneBg}" Padding="16,0">
                                        <TextBlock Text="取消" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource FlatBtn}" Padding="0" Click="OnConfirmQuitApp" Tag="{Binding App}">
                                    <Border Height="40" CornerRadius="20" Background="#FF3B30" Padding="16,0">
                                        <TextBlock Text="退出" FontSize="16" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="退出中..." FontSize="14" Foreground="{DynamicResource PhoneSecondaryText}"
                                       VerticalAlignment="Center" Visibility="{Binding QuittingVis}" Margin="8,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Window Rows -->
                    <ItemsControl ItemsSource="{Binding Windows}" IsEnabled="{Binding NotQuitting}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle Height="1" Fill="{DynamicResource PhoneDividerBrush}" Margin="76,0,0,0"/>
                                    <Grid Height="56" Margin="16,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Style="{StaticResource FlatBtn}"
                                                HorizontalContentAlignment="Stretch"
                                                IsEnabled="{Binding NotClosing}"
                                                Click="OnPullWindow" Tag="{Binding Window}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding RowSymbol}" FontSize="20" Foreground="{Binding RowSymbolBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="17" Foreground="{Binding TitleBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0,8,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding TagsVis}">
                                                    <Border Visibility="{Binding OnPhoneTagVis}" Background="{DynamicResource PhoneTagOnBg}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="在这块屏上" FontSize="13" Foreground="{DynamicResource PhoneTintBlue}"/>
                                                    </Border>
                                                    <Border Visibility="{Binding MinimizedVis}" Background="{DynamicResource PhoneTagMutedBg}" CornerRadius="10" Padding="8,2">
                                                        <TextBlock Text="已最小化" FontSize="13" Foreground="{DynamicResource PhoneSecondaryText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Window trailing actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource FlatBtn}" Width="48" Height="48"
                                                    Visibility="{Binding NormalCloseVis}"
                                                    Click="OnAskCloseWindow" Tag="{Binding}">
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PhoneCloseBtnBg}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="×" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" Visibility="{Binding AskCloseVis}">
                                                <Button Style="{StaticResource FlatBtn}" Margin="0,0,8,0" Click="OnCancelConfirm">
                                                    <Border Height="38" CornerRadius="19" Background="{DynamicResource PhoneBg}" Padding="14,0">
                                                        <TextBlock Text="取消" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Button>
                                                <Button Style="{StaticResource FlatBtn}" Click="OnConfirmCloseWindow" Tag="{Binding Window}">
                                                    <Border Height="38" CornerRadius="19" Background="#FF3B30" Padding="14,0">
                                                        <TextBlock Text="关闭" FontSize="15" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Text="正在关闭" FontSize="14" Foreground="{DynamicResource PhoneSecondaryText}"
                                                       VerticalAlignment="Center" Visibility="{Binding ClosingVis}" Margin="8,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Placed window controls: Zoom - / label / + and Put Back -->
                                    <Grid Visibility="{Binding PlacedControlsVis}" Margin="76,0,12,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding ZoomControlsVis}">
                                            <Button Style="{StaticResource FlatBtn}" IsEnabled="{Binding CanZoomOut}" Click="OnZoomOut">
                                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PhoneBg}">
                                                    <TextBlock Text="A-" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTintBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                            <TextBlock Text="{Binding ZoomText}" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}"
                                                       VerticalAlignment="Center" TextAlignment="Center" MinWidth="78" Margin="8,0"/>
                                            <Button Style="{StaticResource FlatBtn}" IsEnabled="{Binding CanZoomIn}" Click="OnZoomIn">
                                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PhoneBg}">
                                                    <TextBlock Text="A+" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTintBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource FlatBtn}" Click="OnPutBack">
                                            <Border Height="48" CornerRadius="24" Background="{DynamicResource PhoneBg}" Padding="18,0">
                                                <TextBlock Text="↩ 还原" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="PhoneRootGrid" Background="{DynamicResource PhoneBg}">
        <!-- HOME PAGE -->
        <Grid x:Name="HomePageView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Fixed Top Navigation Row (56px touch target) -->
            <Grid x:Name="HomeTopRow" Grid.Row="0" Height="56" Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackBtn" Grid.Column="0" Style="{StaticResource FlatBtn}" Visibility="Collapsed" Click="OnBackToPlaced">
                    <Border Height="48" CornerRadius="24" Background="{DynamicResource PhoneBackPillBg}" Padding="14,0,18,0">
                        <TextBlock x:Name="BackBtnLabel" Text="‹ 返回" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PhoneTintBlue}" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatBtn}" Width="52" Height="52" Click="OnAskDismissScreen" ToolTip="退出手机屏">
                        <TextBlock Text="⏏" FontSize="22" Foreground="{DynamicResource PhoneTintBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource FlatBtn}" Width="44" Height="52" Click="OnOpenModelsPage" ToolTip="手机型号">
                        <TextBlock Text="📱" FontSize="20" Foreground="{DynamicResource PhoneTintBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel Margin="20,4,20,24">
                    <!-- Title -->
                    <TextBlock Text="App" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource PhoneTextPrimary}" Margin="0,0,0,12"/>

                    <!-- Fake Search Bar Button -> Opens Search Page -->
                    <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" Click="OnOpenSearchPage" Margin="0,0,0,12">
                        <Border Height="48" CornerRadius="12" Background="{DynamicResource PhoneFillBg}" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="搜索 App" FontSize="18" Foreground="{DynamicResource PhoneSecondaryText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Dismiss Confirmation Banner -->
                    <Border x:Name="DismissBanner" Visibility="Collapsed" Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="退出手机屏？" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PhoneAlertRed}"/>
                            <TextBlock x:Name="DismissBannerDetail" Text="窗口还原，下次远程时恢复" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FlatBtn}" Margin="0,0,12,0" Click="OnCancelConfirm">
                                    <Border Height="42" CornerRadius="21" Background="{DynamicResource PhoneBg}" Padding="20,0">
                                        <TextBlock Text="取消" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource FlatBtn}" Click="OnConfirmDismissScreen">
                                    <Border Height="42" CornerRadius="21" Background="#FF3B30" Padding="20,0">
                                        <TextBlock Text="退出" FontSize="17" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notice Banner -->
                    <Border x:Name="NoticeBanner" Visibility="Collapsed" Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="NoticeHeadline" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PhoneAlertOrange}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="NoticeDetail" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel x:Name="NoticeActionsRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                                <Button Style="{StaticResource FlatBtn}" Margin="0,0,12,0" Click="OnDismissNotice">
                                    <Border Height="42" CornerRadius="21" Background="{DynamicResource PhoneBg}" Padding="20,0">
                                        <TextBlock Text="稍后" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button x:Name="ForceQuitNoticeBtn" Style="{StaticResource FlatBtn}" Click="OnForceQuitFromNotice">
                                    <Border Height="42" CornerRadius="21" Background="#FF3B30" Padding="20,0">
                                        <TextBlock Text="强制退出" FontSize="17" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                            <Button x:Name="NoticeCloseBtn" Style="{StaticResource FlatBtn}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnDismissNotice">
                                <Border Height="36" CornerRadius="18" Background="{DynamicResource PhoneBg}" Padding="16,0">
                                    <TextBlock Text="知道了" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Segmented Picker: 运行中 | 全部 -->
                    <Border Background="{DynamicResource PhoneFillBg}" CornerRadius="12" Padding="3" Margin="0,8,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RunningTabBtn" Grid.Column="0" Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" Click="OnSelectRunningTab">
                                <Border x:Name="RunningTabBd" Height="38" CornerRadius="9" Background="{DynamicResource PhoneSegmentBg}">
                                    <TextBlock x:Name="RunningTabText" Text="运行中" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="AllTabBtn" Grid.Column="1" Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" Click="OnSelectAllTab">
                                <Border x:Name="AllTabBd" Height="38" CornerRadius="9" Background="Transparent">
                                    <TextBlock x:Name="AllTabText" Text="全部" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSegmentInactiveText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- RUNNING TAB -->
                    <StackPanel x:Name="RunningPagePanel" Visibility="Visible">
                        <!-- Portrait Single Column -->
                        <StackPanel x:Name="PortraitRunningView" Visibility="Visible">
                            <StackPanel x:Name="CurrentAppSection" Visibility="Collapsed" Margin="0,0,0,20">
                                <TextBlock Text="当前 App" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                                <ContentControl x:Name="CurrentAppCardHost" ContentTemplate="{StaticResource AppCardTemplate}"/>
                            </StackPanel>

                            <TextBlock x:Name="OtherAppsHeader" Text="其他 App" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8" Visibility="Collapsed"/>
                            <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource AppCardTemplate}"/>
                        </StackPanel>

                        <!-- Landscape Two-Column View (Phone Landscape / Tablet Landscape) -->
                        <Grid x:Name="LandscapeRunningView" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.25*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Padding="6" VerticalAlignment="Top">
                                <ItemsControl x:Name="LandscapeAppRail">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch"
                                                    Click="OnSelectLandscapeApp" Tag="{Binding}">
                                                <Border Background="{Binding RailBackground}" CornerRadius="9" Padding="12,10" Margin="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="13"
                                                                       Foreground="{Binding SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <ContentControl x:Name="LandscapeSelectedCardHost" Grid.Column="2" ContentTemplate="{StaticResource AppCardTemplate}"/>
                        </Grid>

                        <StackPanel x:Name="RunningEmptyState" Visibility="Collapsed" Margin="0,48,0,48" HorizontalAlignment="Center">
                            <TextBlock x:Name="RunningEmptyText" Text="正在读取" FontSize="18" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ALL APPS TAB: Adaptive Multi-Column Icon Grid -->
                    <StackPanel x:Name="AllAppsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AllLoadingText" Text="正在读取" FontSize="18" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" Margin="0,48,0,48" Visibility="Collapsed"/>
                        <ItemsControl x:Name="AllAppsGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="AllAppsUniformGrid" Columns="4" Loaded="OnAllAppsUniformGridLoaded"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatBtn}" IsEnabled="{Binding NotQuitting}" Click="OnOpenApp" Tag="{Binding App}" Margin="4,0,4,18">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border CornerRadius="16" Background="{DynamicResource PhoneCardBg}" Width="68" Height="68" Padding="10">
                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PhoneTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,8,0,4" MaxWidth="104"/>
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PhoneSecondaryText}" Opacity="{Binding RunningDotOpacity}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- INLINE SEARCH PAGE -->
        <Grid x:Name="SearchPageView" Visibility="Collapsed" Background="{DynamicResource PhoneBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SearchTopRow" Grid.Row="0" Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="48" CornerRadius="12" Background="{DynamicResource PhoneFillBg}" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchInputBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PhoneTextPrimary}" CaretBrush="{DynamicResource PhoneTextPrimary}" FontSize="18" VerticalContentAlignment="Center"
                                 TextChanged="OnSearchInputChanged"/>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Style="{StaticResource FlatBtn}" Visibility="Collapsed"
                                Width="32" Height="32" Click="OnClearSearch">
                            <TextBlock Text="✕" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource FlatBtn}" Margin="12,0,0,0" Click="OnCloseSubPage">
                    <TextBlock Text="取消" FontSize="18" Foreground="{DynamicResource PhoneTintBlue}" VerticalAlignment="Center" Padding="4,10"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel Margin="20,0,20,24">
                    <!-- Letter Groups when search empty -->
                    <ItemsControl x:Name="LetterGroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,8,0,6"/>
                                    <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12">
                                        <ItemsControl ItemsSource="{Binding Apps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" IsEnabled="{Binding NotQuitting}"
                                                            Click="OnSearchOpenApp" Tag="{Binding App}">
                                                        <Grid Margin="16,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Search Matches -->
                    <StackPanel x:Name="SearchResultsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="SearchNoResultText" Text="无结果" FontSize="18" Foreground="{DynamicResource PhoneSecondaryText}"
                                   HorizontalAlignment="Center" Margin="0,48,0,48" Visibility="Collapsed"/>

                        <StackPanel x:Name="SearchAppsSection" Visibility="Collapsed" Margin="0,0,0,20">
                            <TextBlock Text="App" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                            <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12">
                                <ItemsControl x:Name="SearchAppsResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" IsEnabled="{Binding NotQuitting}"
                                                    Click="OnSearchOpenApp" Tag="{Binding App}">
                                                <Grid Margin="16,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SearchWindowsSection" Visibility="Collapsed">
                            <TextBlock Text="窗口" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                            <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12">
                                <ItemsControl x:Name="SearchWindowsResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch"
                                                    Click="OnSearchPullWindow" Tag="{Binding Window}">
                                                <Grid Margin="16,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AppName}" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- INLINE PHONE MODEL PAGE -->
        <Grid x:Name="ModelPageView" Visibility="Collapsed" Background="{DynamicResource PhoneBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ModelTopRow" Grid.Row="0" Height="56" Margin="20,12,20,0">
                <TextBlock Text="手机型号" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource FlatBtn}" HorizontalAlignment="Right" Click="OnCloseSubPage">
                    <TextBlock Text="完成" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTintBlue}" VerticalAlignment="Center" Padding="8,10"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel Margin="20,8,20,24">
                    <Border Height="48" CornerRadius="12" Background="{DynamicResource PhoneFillBg}" Padding="12,0" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ModelSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PhoneTextPrimary}" CaretBrush="{DynamicResource PhoneTextPrimary}" FontSize="18" VerticalContentAlignment="Center"
                                     TextChanged="OnModelSearchChanged"/>
                        </Grid>
                    </Border>

                    <!-- Current -->
                    <StackPanel x:Name="CurrentModelSection" Margin="0,0,0,20">
                        <TextBlock Text="当前 · 手机屏按它调整比例" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                        <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="CurrentModelTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}"/>
                                <TextBlock x:Name="CurrentModelSize" FontSize="16" Foreground="{DynamicResource PhoneSecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Custom -->
                    <StackPanel x:Name="CustomModelSection" Margin="0,0,0,20">
                        <TextBlock Text="自定义" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                        <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="44" CornerRadius="10" Background="{DynamicResource PhoneFillBg}">
                                        <TextBox x:Name="CustomWidthBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PhoneTextPrimary}" CaretBrush="{DynamicResource PhoneTextPrimary}"
                                                 FontSize="17" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="×" FontSize="18" Foreground="{DynamicResource PhoneSecondaryText}" VerticalAlignment="Center" Margin="10,0"/>
                                    <Border Grid.Column="2" Height="44" CornerRadius="10" Background="{DynamicResource PhoneFillBg}">
                                        <TextBox x:Name="CustomHeightBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PhoneTextPrimary}" CaretBrush="{DynamicResource PhoneTextPrimary}"
                                                 FontSize="17" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource FlatBtn}" Margin="12,0,0,0" Click="OnApplyCustomModel">
                                        <Border Height="44" CornerRadius="22" Background="{DynamicResource PhoneBg}" Padding="18,0">
                                            <TextBlock Text="使用" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource PhoneTintBlue}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </Grid>
                                <TextBlock Text="屏幕分辨率或比例，如 1080 × 2400、9 × 20" FontSize="14" Foreground="{DynamicResource PhoneSecondaryText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Brands -->
                    <ItemsControl x:Name="ModelBrandsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource PhoneSecondaryText}" Margin="4,0,0,8"/>
                                    <Border Background="{DynamicResource PhoneCardBg}" CornerRadius="12">
                                        <ItemsControl ItemsSource="{Binding Models}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FlatBtn}" HorizontalContentAlignment="Stretch" Click="OnSelectPhoneModel" Tag="{Binding Model}">
                                                        <Grid Margin="20,14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" FontSize="18" Foreground="{DynamicResource PhoneTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SizeText}" FontSize="14" Foreground="{DynamicResource PhoneSecondaryText}" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="✓" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PhoneTintBlue}"
                                                                       VerticalAlignment="Center" Visibility="{Binding CheckVis}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FULL-SCREEN BUSY VIEW (opening / placing / reshaping / dismissing) -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource PhoneBg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Border CornerRadius="20" Background="{DynamicResource PhoneCardBg}" Width="96" Height="96" Padding="14" HorizontalAlignment="Center">
                    <Image x:Name="BusyIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="BusyTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PhoneTextPrimary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,16,0,4"/>
                <TextBlock x:Name="BusySubtitle" FontSize="17" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <TextBlock x:Name="BusyStatus" FontSize="15" Foreground="{DynamicResource PhoneSecondaryText}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
