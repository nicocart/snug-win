<Window x:Class="SnugWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SnugWin"
        Width="464" Height="696"
        MinWidth="430" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FontFamily="{StaticResource AppFont}"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            CornerRadius="12"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Mica Title & Navigation Chrome -->
        <Grid Grid.Row="0" Margin="16,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Title (Home) OR Subpage Back Button -->
            <StackPanel x:Name="HeaderBrandGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="{DynamicResource TileIconBoxBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="3" Margin="0,0,9,0">
                    <Image Source="/SnugWin.App;component/Assets/snugwin-logo.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="SnugWin" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource BadgePillBg}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadgeText" Text="v1.2" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="HeaderSubpageGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeIconButton}" Width="Auto" Padding="8,0" Click="OnBackHome" ToolTip="返回主控制卡">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M9.5,3 L4.5,8 L9.5,13" Width="11" Height="11" Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SubpageTitleText" Text="详情" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Quick Chrome Utility & Caption Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeIconButton}" Click="OnOpenDiagnosticsTab" ToolTip="驱动状态与实时日志" Margin="0,0,2,0">
                    <Grid Width="16" Height="16">
                        <Path Data="M2.5,3.5 L6.5,7.5 L2.5,11.5 M8,11.5 L13.5,11.5" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="DiagAlertDot" Width="6" Height="6" Fill="{DynamicResource WarningHeading}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnOpenAboutTab" ToolTip="版本更新与关于" Margin="0,0,4,0">
                    <Grid Width="16" Height="16">
                        <Path Data="M8,14 A6,6 0 1 1 8,2 A6,6 0 1 1 8,14 Z M8,7.2 L8,10.8 M8,4.8 L8,5" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="{DynamicResource SuccessText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Border Width="1" Height="14" Background="{DynamicResource ChromeDividerBg}" Margin="4,0,6,0" VerticalAlignment="Center"/>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnMinimizeClick" ToolTip="最小化" Margin="0,0,2,0">
                    <Path Data="M3,8 L13,8" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                </Button>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnCloseToTrayClick" ToolTip="收起到托盘">
                    <Path Data="M3,3 L11,11 M11,3 L3,11" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="16,4,16,16">

            <!-- VIEW 0: BENTO CONTROL CENTER -->
            <Grid x:Name="PageHome">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Hero Tile: Driver Setup Warning (when missing) OR Live Status + Reentry -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- Missing Driver Hero Card -->
                    <Border x:Name="DriverWarningBanner"
                            Background="{DynamicResource WarningBg}"
                            BorderBrush="{DynamicResource WarningBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="15,12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,2 L14,13 L2,13 Z M8,6.5 L8,9.5 M8,11.3 L8,11.5" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{DynamicResource WarningHeading}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="虚拟屏驱动未就绪" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningHeading}"/>
                                </StackPanel>
                                <TextBlock x:Name="DriverWarningText" FontSize="11.5" Foreground="{DynamicResource WarningBody}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="InstallDriverBtn" Grid.Column="1" Content="一键安装" Style="{StaticResource PrimaryButton}"
                                    Padding="14,8" FontSize="12.5" VerticalAlignment="Center" Click="OnInstallDriver"/>
                        </Grid>
                    </Border>

                    <!-- Ready / Live Status Hero Card -->
                    <Border x:Name="StatusHeroCard"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusIndicatorDot" Width="8" Height="8" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StatusText" Text="待机中 · 等待手机连入" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="ElevationText" Text="管理员权限" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · 管道已连接" FontSize="11.5" Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HeroEndNowBtn" Content="立即结束" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" FontSize="11.5" Margin="0,0,6,0" Click="OnEndSessionNowClick" Visibility="Collapsed"/>
                                <Button x:Name="ElevateBtn" Content="提权重启" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" FontSize="11.5" Margin="0,0,6,0" Click="OnRestartElevated" Visibility="Collapsed"/>
                                <Button x:Name="HeroReentryBtn" Content="进入手机屏" Style="{StaticResource PrimaryButton}"
                                        Padding="13,7" FontSize="12" Click="OnReenterClick" Visibility="Collapsed"/>
                                <Border x:Name="HeroReadyBadge" Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                    <TextBlock Text="已就绪" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Asymmetric Bento Middle Row: Phone Ratio + Terminal Zoom Stepper -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Bento Tile: Active Phone Model + Aspect Silhouette + Preview/Switch -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="15,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="当前主屏" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Button x:Name="ScreensNavBtn" Click="OnOpenScreensTab" Margin="6,0,0,0" Cursor="Hand"
                                                Background="{DynamicResource AccentSoftBg}" BorderBrush="{DynamicResource AccentSoftBorder}"
                                                BorderThickness="1" Padding="6,1" ToolTip="多屏管理（最多支持 4 块虚拟屏）">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock x:Name="ScreensSummaryBadge" Text="多屏 1/4 ›" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentSoftText}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="PhoneModelText" Text="iPhone 17 Pro" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PhoneSpecText" Text="1206 × 2622 · 200%" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" Foreground="{DynamicResource AccentSoftText}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Proportional Phone Outline Preview -->
                                <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="{DynamicResource TileIconBoxBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        CornerRadius="8" Width="40" Height="46">
                                    <Border x:Name="PhoneFrameOutline" Width="16" Height="34" CornerRadius="3"
                                            BorderBrush="{DynamicResource AccentSoftText}" BorderThickness="1.5"
                                            Background="{DynamicResource PhoneFrameFill}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="1.5" CornerRadius="0.75" Background="{DynamicResource AccentSoftText}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,2.5"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="预览界面" Style="{StaticResource SecondaryButton}"
                                        Padding="8,7" FontSize="12" Click="OnOpenPreview"/>
                                <Button Grid.Column="2" Content="换机型..." Style="{StaticResource PrimaryButton}"
                                        Padding="8,7" FontSize="12" Click="OnOpenModels"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Bento Tile: Tactile Zoom Stepper -->
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="终端 / IDE 字号" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>

                            <Grid Grid.Row="1" Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ZoomMinusBtn" Grid.Column="0" Content="−" Style="{StaticResource StepperButton}" Click="OnZoomMinus"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ZoomValueText" Text="+2" FontFamily="{StaticResource MonoFont}"
                                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="放大档位" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="ZoomPlusBtn" Grid.Column="2" Content="+" Style="{StaticResource StepperButton}" Click="OnZoomPlus"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="投屏自动放大，退出还原" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. 2x2 Interactive Bento Quick-Toggle Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile 1: Auto Portrait Virtual Screen -->
                    <CheckBox x:Name="PhoneScreenCheck" Grid.Row="0" Grid.Column="0" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnPhoneScreenChanged" Unchecked="OnPhoneScreenChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource TileIconBoxBg}" HorizontalAlignment="Left">
                                <Path Data="M5,2.5 L11,2.5 C11.8,2.5 12.5,3.2 12.5,4 L12.5,12 C12.5,12.8 11.8,13.5 11,13.5 L5,13.5 C4.2,13.5 3.5,12.8 3.5,12 L3.5,4 C3.5,3.2 4.2,2.5 5,2.5 Z M7,11.5 L9,11.5"
                                      Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="自动竖屏" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="远程连入自动建屏归位" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>

                    <!-- Tile 2: Touch Gestures + Subpage Shortcut -->
                    <Grid Grid.Row="0" Grid.Column="2">
                        <CheckBox x:Name="GesturesCheck" Style="{StaticResource BentoTileCheckBox}"
                                  Checked="OnGesturesChanged" Unchecked="OnGesturesChanged">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource TileIconBoxBg}" HorizontalAlignment="Left">
                                    <Path Data="M4,4 L12,4 M4,8 L14,8 M4,12 L10,12" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="触控手势" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="惯性滚轮 · 选字浮条" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </CheckBox>
                        <Button Content="细项 ›" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,28,0"
                                Padding="7,3" FontSize="11" Background="{DynamicResource BgControl}" Foreground="{DynamicResource TextPrimary}"
                                BorderThickness="0" Cursor="Hand" Click="OnOpenGesturesTab" ToolTip="配置手势开关细项">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgControlHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Tile 3: Screenshot Camera Key -->
                    <CheckBox x:Name="ScreenshotCheck" Grid.Row="2" Grid.Column="0" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource TileIconBoxBg}" HorizontalAlignment="Left">
                                <Path Data="M2.5,5.5 L5,5.5 L6.2,3.5 L9.8,3.5 L11,5.5 L13.5,5.5 C14,5.5 14.5,6 14.5,6.5 L14.5,12.5 C14.5,13 14,13.5 13.5,13.5 L2.5,13.5 C2,13.5 1.5,13 1.5,12.5 L1.5,6.5 C1.5,6 2,5.5 2.5,5.5 Z M8,11.5 A2.2,2.2 0 1 1 8,7.1 A2.2,2.2 0 1 1 8,11.5 Z"
                                      Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="截屏相机键" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="原图剪贴板 + 8把手裁剪" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>

                    <!-- Tile 4: Silent Autostart -->
                    <CheckBox x:Name="AutoStartCheck" Grid.Row="2" Grid.Column="2" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource TileIconBoxBg}" HorizontalAlignment="Left">
                                <Path Data="M8,2.5 L8,7.5 M4.8,4.3 A5.2,5.2 0 1 0 11.2,4.3"
                                      Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="最高权限静默常驻托盘" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>
                </Grid>

                <!-- 4. Appearance Theme Mode Selector (Applies to Desktop & Virtual Phone UI) -->
                <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="15,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="外观主题（桌面与虚拟屏同步）" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="9" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLightBtn" GroupName="ThemeMode" Content="浅色" Style="{StaticResource SegmentRadio}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeDarkBtn" GroupName="ThemeMode" Content="暗黑" Style="{StaticResource SegmentRadio}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeAutoBtn" GroupName="ThemeMode" Content="自动" Style="{StaticResource SegmentRadio}"
                                             Checked="OnThemeModeChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 5. Bottom Utility Strip: Manual Override Test Toggle -->
                <Border Grid.Row="4" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="15,11">
                    <CheckBox x:Name="ManualPhoneCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                              Checked="OnManualChanged" Unchecked="OnManualChanged">
                        <StackPanel>
                            <TextBlock Text="手动强制开启手机屏（测试 / 探测兜底）" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoftText}"/>
                            <TextBlock Text="无需远程连入，直接生成并试用桌面侧手机工作区" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </Grid>

            <!-- VIEW 1: GESTURE DETAILS SUBPAGE -->
            <ScrollViewer x:Name="PageGestures" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <StackPanel>
                            <CheckBox x:Name="GestureScrollCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureScrollChanged" Unchecked="OnGestureScrollChanged">
                                <StackPanel>
                                    <TextBlock Text="单指滑动转为平滑滚动与 60fps 惯性" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="长按 0.5 秒后拖动切换为划选模式，浏览器标签栏保持直通"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="CopyAfterSelectionCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnCopyAfterSelectionChanged" Unchecked="OnCopyAfterSelectionChanged">
                                <StackPanel>
                                    <TextBlock Text="划选松手后弹出悬浮操作条（复制 / 粘贴 / 删除）" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="终端自动用 Ctrl+Shift+C / V，删除发 Backspace 不污染剪贴板"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="GestureRightClickCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureRightClickChanged" Unchecked="OnGestureRightClickChanged">
                                <StackPanel>
                                    <TextBlock Text="原地长按松开触发鼠标右键" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="如果在终端里不希望误触右键粘贴，可在此单独关闭"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{DynamicResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="InjectedOnlyCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnInjectedOnlyChanged" Unchecked="OnInjectedOnlyChanged">
                                <StackPanel>
                                    <TextBlock Text="仅接管远程注入触控事件" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="保留本机物理鼠标跨入手机屏时的原生点击与拖拽手感"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 2: DIAGNOSTICS & LOGS SUBPAGE -->
            <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="15,13" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="virtual-display-rs 0.3.1 驱动通道" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="DiagPipeText" Text="检查中..." FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="安装 / 修复驱动" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0" Click="OnInstallDriver"/>
                            <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OnOpenLogDir"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BgWell}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource LogTextColor}"
                             CaretBrush="{DynamicResource CaretBrushColor}" SelectionBrush="#2563EB"
                             BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                </Border>
            </Grid>

            <!-- VIEW 3: ABOUT & UPDATES SUBPAGE -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersionText" Text="当前版本：v1.2.1" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="UpdateStateText" Text="点击下方按钮检查 GitHub 最新正式版" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,0,0,12" Minimum="0" Maximum="1"
                                         Foreground="{DynamicResource AccentBlueHover}" Background="{DynamicResource BgControl}"
                                         BorderThickness="0" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateBtn" Content="检查更新" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate"/>
                                <Button x:Name="InstallUpdateBtn" Content="下载并更新重启" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                        <CheckBox x:Name="AutoCheckUpdatesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnAutoCheckUpdatesChanged" Unchecked="OnAutoCheckUpdatesChanged">
                            <StackPanel>
                                <TextBlock Text="启动时自动检查新版本" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="升级前会自动校对 checksums.txt 的 SHA-256 哈希，确保更新包完整"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="致谢与开源许可" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AboutCreditText" Text="MIT License（nicocart/snug-win），承接上游 zephyr4123/snug（v2.8.0）多屏多机型、多远控适配、提前准备虚拟屏与交互状态机。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="虚拟屏驱动基于 MolotovCherry/virtual-display-rs（0.3.1），内置 SHA-256 与签名指纹校验。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="访问 GitHub 仓库" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenRepo"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 4: MULTI-SCREEN MANAGEMENT SUBPAGE -->
            <Grid x:Name="PageScreens" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="可同时启用最多 4 块虚拟屏；支持手机、平板与电脑常见比例，各屏幕状态独立管理。"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,0,2,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <ItemsControl x:Name="ScreensList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Background="{DynamicResource BadgePillBg}" CornerRadius="4" Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindOrientationBadge}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSoftBg}" BorderBrush="{DynamicResource AccentSoftBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="5,0,0,0"
                                                            VerticalAlignment="Center" Visibility="{Binding MainBadgeVisibility}">
                                                        <TextBlock Text="常驻" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentSoftText}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSoftBg}" BorderBrush="{DynamicResource AccentSoftBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="5,0,0,0"
                                                            VerticalAlignment="Center" Visibility="{Binding ReadyBadgeVisibility}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentSoftText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeviceSummary}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchCheckBox}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="OnScreenEnabledClick" Tag="{Binding Id}"
                                                      VerticalAlignment="Center" ToolTip="启用或停用此虚拟屏"/>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                            <Button Content="{Binding MainActionLabel}" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                    Click="OnToggleMainScreenClick" Tag="{Binding Id}"
                                                    ToolTip="开启后此虚拟屏不等远程连接即常驻，断开时窗口原样保留"/>
                                            <Button Content="{Binding OtherOrientationLabel}" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                    Visibility="{Binding OtherOrientationVisibility}"
                                                    Click="OnUseOtherOrientationClick" Tag="{Binding Id}"
                                                    ToolTip="添加或启用同型号的另一方向屏幕"/>
                                            <Button Content="预览界面" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="11.5" Margin="0,0,6,0"
                                                    Visibility="{Binding PreviewVisibility}"
                                                    Click="OnPreviewScreenClick" Tag="{Binding Id}"/>
                                            <Button Content="换机型..." Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="11.5"
                                                    Click="OnSwapScreenModelClick" Tag="{Binding Id}"/>
                                            <Button Content="删除" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" FontSize="11.5" Margin="6,0,0,0"
                                                    Visibility="{Binding DeleteVisibility}"
                                                    Click="OnDeleteScreenClick" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Keep Screens Ready Card (for launch-only display remotes like CrossDesk) -->
                <Border x:Name="KeepScreensReadyCard" Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,10" Visibility="Collapsed">
                    <CheckBox x:Name="KeepScreensReadyCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                              Click="OnKeepScreensReadyClick">
                        <StackPanel>
                            <TextBlock Text="提前准备虚拟屏" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="KeepScreensReadyDetailText" Text="SnugWin 启动时即建立屏幕" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Add Screen Bento Card -->
                <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="添加虚拟屏" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AddScreenLimitHint" Grid.Column="1" Text="1 / 4" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="AddScreenFormPanel">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="9" Padding="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="AddPhoneKindBtn" Grid.Column="0" Content="手机" GroupName="AddScreenKind"
                                                     Style="{StaticResource SegmentRadio}" Click="OnAddKindChanged" IsChecked="True"/>
                                        <RadioButton x:Name="AddTabletKindBtn" Grid.Column="1" Content="平板" GroupName="AddScreenKind"
                                                     Style="{StaticResource SegmentRadio}" Click="OnAddKindChanged"/>
                                        <RadioButton x:Name="AddComputerKindBtn" Grid.Column="2" Content="电脑" GroupName="AddScreenKind"
                                                     Style="{StaticResource SegmentRadio}" Click="OnAddKindChanged"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="9" Padding="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="AddPortraitBtn" Grid.Column="0" Content="竖屏" GroupName="AddScreenOrient"
                                                     Style="{StaticResource SegmentRadio}" IsChecked="True"/>
                                        <RadioButton x:Name="AddLandscapeBtn" Grid.Column="1" Content="横屏" GroupName="AddScreenOrient"
                                                     Style="{StaticResource SegmentRadio}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Height="34">
                                    <TextBox x:Name="AddScreenNameBox" Style="{StaticResource DarkTextBox}" Padding="10,0"
                                             VerticalContentAlignment="Center" MaxLength="24"/>
                                    <TextBlock Text="屏幕名称（留空自动命名）" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=AddScreenNameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="2" Content="选型号并添加" Style="{StaticResource PrimaryButton}"
                                        Height="34" Padding="14,0" FontSize="12" Click="OnAddScreenWithPicker"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="AddScreenFullText" Text="已达到虚拟屏数量上限（4 块），可删除或停用上方屏幕后再新增。"
                                   FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
