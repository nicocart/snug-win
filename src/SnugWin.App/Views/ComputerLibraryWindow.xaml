<Window x:Class="SnugWin.App.Views.ComputerLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugComputerLibrary"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">
    <Window.Resources>
        <Style x:Key="LibRowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibSmallBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LibraryRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource LibRowBtn}"
                        Background="{Binding RowBackground}"
                        IsEnabled="{Binding Enabled}"
                        Click="OnRowClick" Tag="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding SubtitleVis}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding ActionLabel}" FontSize="11.5"
                                   Foreground="{Binding ActionBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Content="还原" Style="{StaticResource LibSmallBtn}"
                        Visibility="{Binding RestoreVis}"
                        IsEnabled="{Binding Enabled}"
                        Margin="4,0,2,0" VerticalAlignment="Center"
                        Click="OnRestoreRowClick" Tag="{Binding}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource BgCardElevated}"
            BorderBrush="{DynamicResource BubbleBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <Border Grid.Row="0" Background="{DynamicResource BgControl}"
                    BorderBrush="{DynamicResource BorderControl}"
                    BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource CaretBrushColor}"
                             FontSize="12.5" VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                               Text="搜索 App 或窗口（支持拼音）"
                               FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="×"
                            Style="{StaticResource LibSmallBtn}" Padding="5,0" Margin="4,0,0,0"
                            Visibility="Collapsed" Click="OnClearSearch"/>
                </Grid>
            </Border>

            <!-- Segmented Switcher -->
            <Border x:Name="SegmentBar" Grid.Row="1" Background="{DynamicResource BgControl}"
                    CornerRadius="8" Padding="2" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunningTabBtn" Grid.Column="0" Content="运行中"
                            Style="{StaticResource SegTabBtn}" Click="OnSelectRunningTab"/>
                    <Button x:Name="AllTabBtn" Grid.Column="1" Content="全部"
                            Style="{StaticResource SegTabBtn}" Click="OnSelectAllTab"/>
                </Grid>
            </Border>

            <!-- Status / Notice Banner -->
            <Border x:Name="BannerCard" Grid.Row="2" Background="{DynamicResource BgWell}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="BannerTitle" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BannerDetail" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BannerCloseBtn" Grid.Column="1" Content="×"
                            Style="{StaticResource LibSmallBtn}" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Top" Click="OnDismissBanner"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ContentHost">
                    <!-- Grouped list (Running or Search) -->
                    <StackPanel x:Name="GroupedPanel">
                        <!-- Here Group -->
                        <StackPanel x:Name="HereSection" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="这块屏" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,4"/>
                            <ItemsControl x:Name="HereList" ItemTemplate="{StaticResource LibraryRowTemplate}"/>
                        </StackPanel>

                        <!-- Elsewhere Group -->
                        <StackPanel x:Name="ElsewhereSection" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="其他位置" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,4"/>
                            <ItemsControl x:Name="ElsewhereList" ItemTemplate="{StaticResource LibraryRowTemplate}"/>
                        </StackPanel>

                        <!-- Windowless Group -->
                        <StackPanel x:Name="WindowlessSection" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="没有窗口" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,4"/>
                            <ItemsControl x:Name="WindowlessList" ItemTemplate="{StaticResource LibraryRowTemplate}"/>
                        </StackPanel>

                        <!-- Unopened Group (Search only) -->
                        <StackPanel x:Name="UnopenedSection" Visibility="Collapsed" Margin="0,0,0,4">
                            <TextBlock Text="未打开" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,4"/>
                            <ItemsControl x:Name="UnopenedList" ItemTemplate="{StaticResource LibraryRowTemplate}"/>
                        </StackPanel>

                        <TextBlock x:Name="EmptyStateText" Text="没有匹配的应用或窗口"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,36,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- All Apps Grid -->
                    <ItemsControl x:Name="AllAppsGrid" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LibRowBtn}" Padding="4,8"
                                        Click="OnAllAppClick" Tag="{Binding App}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="34" Height="34"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="64"
                                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentSoftText}"
                                                 HorizontalAlignment="Center" Opacity="{Binding RunningDotOpacity}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
