<Window x:Class="SnugWin.App.Views.PhoneModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择设备型号与分辨率"
        Width="464" Height="648"
        MinWidth="410" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        FontFamily="{StaticResource AppFont}"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="12"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Mica Title Chrome -->
        <Grid Grid.Row="0" Margin="16,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WindowTitleText" Grid.Column="0" Text="选择设备型号与分辨率" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ChromeIconButton}" Click="OnCloseClick" ToolTip="关闭"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M3,3 L11,11 M11,3 L3,11" Width="10" Height="10" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Active Device + Custom Aspect Bento Tile -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AccentSoftBg}" BorderBrush="{DynamicResource AccentSoftBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="当前生效" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoftText}"/>
                    </Border>
                    <TextBlock x:Name="CurrentLabel" Grid.Column="1" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CustomHintText" Grid.Row="0" Text="自定义分辨率 / 比例（例如 1080 × 2400 或 1920 × 1080）"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,9"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="34">
                                <TextBox x:Name="CustomWidthBox" Style="{StaticResource DarkTextBox}" Padding="10,0"
                                         VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="宽 (如 1080)" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CustomWidthBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="×" FontSize="13.5" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextSecondary}"/>
                            <Grid Grid.Column="2" Height="34">
                                <TextBox x:Name="CustomHeightBox" Style="{StaticResource DarkTextBox}" Padding="10,0"
                                         VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="高 (如 2400)" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CustomHeightBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="4" Content="应用" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" Click="OnApplyCustom"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Category Filter + Search Input -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Border x:Name="KindFilterBar" Background="{DynamicResource BgControl}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColAll" Width="*"/>
                            <ColumnDefinition x:Name="ColPhone" Width="*"/>
                            <ColumnDefinition x:Name="ColTablet" Width="*"/>
                            <ColumnDefinition x:Name="ColComputer" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="AllKindBtn" Grid.Column="0" Content="全部" GroupName="ModelKind"
                                     Style="{StaticResource SegmentRadio}" Click="OnKindFilterClick" IsChecked="True"/>
                        <RadioButton x:Name="PhoneKindBtn" Grid.Column="1" Content="手机" GroupName="ModelKind"
                                     Style="{StaticResource SegmentRadio}" Click="OnKindFilterClick"/>
                        <RadioButton x:Name="TabletKindBtn" Grid.Column="2" Content="平板" GroupName="ModelKind"
                                     Style="{StaticResource SegmentRadio}" Click="OnKindFilterClick"/>
                        <RadioButton x:Name="ComputerKindBtn" Grid.Column="3" Content="电脑" GroupName="ModelKind"
                                     Style="{StaticResource SegmentRadio}" Click="OnKindFilterClick"/>
                    </Grid>
                </Border>

                <!-- Quick Generic Ratio Presets (zero model hunting) -->
                <Border x:Name="GenericPresetsCard" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="快速通用比例（无需找具体型号，适配绝大多数设备）" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                        <ItemsControl x:Name="GenericPresetsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11.5" Margin="0,0,6,5"
                                            Click="OnSelectGenericPreset" Tag="{Binding Choice}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="34,8,12,8"
                             TextChanged="OnSearchChanged" ToolTip="支持品牌或型号模糊搜索（如 iPhone 17、iPad Pro、1080P）"/>
                    <TextBlock Text="搜索品牌或型号（如 iPhone 17、iPad Pro、2K...）"
                               FontSize="12" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="35,0,12,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Data="M7,12 A5,5 0 1 1 7,2 A5,5 0 1 1 7,12 Z M11,11 L14.5,14.5"
                          Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>

            <!-- Model Catalog Bento List -->
            <ListBox x:Name="ModelList" Grid.Row="2"
                     Background="{DynamicResource BgCard}"
                     BorderBrush="{DynamicResource BorderSubtle}"
                     BorderThickness="1"
                     Padding="4"
                     Foreground="{DynamicResource TextPrimary}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnModelDoubleClick">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="2,2"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChromeHoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBg}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <Border Background="{DynamicResource BadgePillBg}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ResolutionText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="选用" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12"
                                    Click="OnSelectRow" Tag="{Binding}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" Margin="2,10,2,0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Text="提示：更换比例在线生效；UU远程 切换一次屏幕再切回，CrossDesk 点击设置页「一键重启远控」即可同步精确点按。"/>
        </Grid>
    </Grid>
</Window>
